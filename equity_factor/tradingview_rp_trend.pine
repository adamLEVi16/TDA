//@version=5
// ============================================================================
// RP+TREND — MONTHLY REBALANCE DASHBOARD + EQUITY-CURVE REPLAY
//
// Exact port of equity_factor/multi_asset.py's signal logic:
//   - For each of 8 asset-class ETFs, at MONTH CLOSE:
//       trend ON  = monthly close > 10-month SMA of monthly closes
//   - Position size = inverse of 12-month volatility, normalized across ALL
//     8 assets (so trend-OFF sleeves go to cash rather than being
//     redistributed) — identical to rp_full.where(trend, 0) in the engine.
//   - Cash = 1 - sum(weights), parked in T-bills in the backtest.
//
// WHAT THIS PLOTS: a synthetic equity curve for the whole 8-ETF portfolio
// (Strategy NAV) next to 100%-SPY buy & hold, both starting at "Start capital".
// It compounds the realized monthly portfolio return =
//   sum_i( last-month target weight_i * this-month return_i ) + cash*T-bill.
// TradingView Strategies are single-instrument, so a multi-asset book cannot
// run in the Strategy tester — this indicator reconstructs the same P&L path
// the Python engine and replay.html produce, so you can watch it in TV.
//
// HOW TO USE (forward test + replay):
//   1. Open a MONTHLY chart (any symbol; SPY is natural).
//   2. Pine Editor -> paste this -> Add to chart.
//   3. LIVE: the tables show target weights + running stats. Values CONFIRM at
//      month close; mid-month is a moving preview.
//   4. REPLAY the history: click TradingView's "Replay" (bar-replay) button,
//      pick a start month, and step forward — the two NAV lines and the stats
//      table build month by month, the same play-through as replay.html.
//   5. Rebalance on/near the last trading day of each month. Timing is not
//      delicate: the backtest survives executing up to 21 sessions late.
//   6. Optional alert: "Any alert() function call" -> notified when the
//      month-close allocation actually changes.
//
// PYTHON<->PINE PARITY NOTES (for reviewers checking implementation match):
//   - stdev convention: ta.stdev is POPULATION std; the Python engine uses
//     SAMPLE std (pandas ddof=1). This scales every asset's vol by the same
//     sqrt(11/12), which cancels exactly in the inverse-vol normalization --
//     verified numerically: max weight difference 5.6e-17. Not a divergence.
//   - ADJUSTED DATA REQUIRED: the Python engine uses dividend+split adjusted
//     closes. On TradingView, enable "Adj" (adjusted data) AND dividend
//     adjustment in chart settings; without it, high-yield sleeves
//     (TLT/IEF/VNQ) can show different trend states AND the NAV curve drifts
//     low (missing dividends).
//   - CASH RETURN is APPROXIMATE: the Python engine credits idle cash with the
//     realized 1-month T-bill each month; Pine has no T-bill feed, so cash
//     earns the flat "Cash yield" input (default 0%). At 0% the NAV curve is a
//     slight UNDERSTATEMENT in high-cash periods — set it to a representative
//     rate (e.g. 2) if you want a closer match; the signal/weights are
//     unaffected either way.
//   - NAV compounds only on CONFIRMED month closes (no intramonth repaint of
//     the equity value), matching decide-at-close-of-m, hold-month-m+1.
//   - Warm-up: NAV starts once all 8 assets have full history (common-history,
//     like the engine's dropna); early bars are inert.
//
// Track your actual fills in a spreadsheet or broker paper account; this is
// the signal + expected-path source, not an order-execution engine.
// ============================================================================
indicator("RP+Trend — Dashboard + Equity Replay", overlay = false)

smaLen   = input.int(10,     "Trend filter (months)",   minval = 2)
volLen   = input.int(12,     "Volatility window (months)", minval = 3)
startCap = input.float(100000, "Start capital ($)",      minval = 1)
cashAPR  = input.float(0.0,  "Cash yield (annual %, T-bill proxy)", minval = 0) / 100.0

s1 = input.symbol("AMEX:SPY",    "US equity")
s2 = input.symbol("AMEX:EFA",    "Intl developed equity")
s3 = input.symbol("AMEX:EEM",    "Emerging markets")
s4 = input.symbol("NASDAQ:TLT",  "20+yr Treasuries")
s5 = input.symbol("NASDAQ:IEF",  "7-10yr Treasuries")
s6 = input.symbol("AMEX:GLD",    "Gold")
s7 = input.symbol("AMEX:DBC",    "Commodities")
s8 = input.symbol("AMEX:VNQ",    "REITs")

f(sym) =>
    request.security(sym, "M",
         [close, ta.sma(close, smaLen), ta.stdev(close / close[1] - 1, volLen)],
         lookahead = barmerge.lookahead_off)

[c1, m1, v1] = f(s1)
[c2, m2, v2] = f(s2)
[c3, m3, v3] = f(s3)
[c4, m4, v4] = f(s4)
[c5, m5, v5] = f(s5)
[c6, m6, v6] = f(s6)
[c7, m7, v7] = f(s7)
[c8, m8, v8] = f(s8)

t1 = c1 > m1
t2 = c2 > m2
t3 = c3 > m3
t4 = c4 > m4
t5 = c5 > m5
t6 = c6 > m6
t7 = c7 > m7
t8 = c8 > m8

// inverse-vol weights normalized over ALL assets, zeroed where trend is off
iv(v) => (na(v) or v <= 0) ? float(na) : 1.0 / v
i1 = iv(v1)
i2 = iv(v2)
i3 = iv(v3)
i4 = iv(v4)
i5 = iv(v5)
i6 = iv(v6)
i7 = iv(v7)
i8 = iv(v8)
ivSum = nz(i1) + nz(i2) + nz(i3) + nz(i4) + nz(i5) + nz(i6) + nz(i7) + nz(i8)
w(iw, t) => ivSum > 0 ? (t ? nz(iw) / ivSum : 0.0) : float(na)
w1 = w(i1, t1)
w2 = w(i2, t2)
w3 = w(i3, t3)
w4 = w(i4, t4)
w5 = w(i5, t5)
w6 = w(i6, t6)
w7 = w(i7, t7)
w8 = w(i8, t8)
invested = w1 + w2 + w3 + w4 + w5 + w6 + w7 + w8
cashW    = math.max(0.0, 1.0 - invested)

// ------------------------------------------------ synthetic portfolio equity
// realized return THIS month uses LAST month's target weights (hold-m+1),
// matching the engine's decide-at-m / hold-m+1 timing.
r1 = nz(c1 / c1[1] - 1)
r2 = nz(c2 / c2[1] - 1)
r3 = nz(c3 / c3[1] - 1)
r4 = nz(c4 / c4[1] - 1)
r5 = nz(c5 / c5[1] - 1)
r6 = nz(c6 / c6[1] - 1)
r7 = nz(c7 / c7[1] - 1)
r8 = nz(c8 / c8[1] - 1)
monthlyCash = cashAPR / 12.0
portRet = nz(w1[1]) * r1 + nz(w2[1]) * r2 + nz(w3[1]) * r3 + nz(w4[1]) * r4 +
     nz(w5[1]) * r5 + nz(w6[1]) * r6 + nz(w7[1]) * r7 + nz(w8[1]) * r8 +
     nz(cashW[1]) * monthlyCash

// common-history gate: all 8 assets must have full trend+vol history (like the
// engine's dropna) before the NAV starts compounding
ready = not na(v1) and not na(v2) and not na(v3) and not na(v4) and
     not na(v5) and not na(v6) and not na(v7) and not na(v8) and
     not na(m1) and not na(m2) and not na(m3) and not na(m4) and
     not na(m5) and not na(m6) and not na(m7) and not na(m8)
valid = ready and ready[1]

var float nav    = startCap
var float spyNav = startCap
var float peak   = startCap
var int   nMonth = 0
if barstate.isconfirmed and valid
    nav    := nav * (1.0 + portRet)
    spyNav := spyNav * (1.0 + r1)
    peak   := math.max(peak, nav)
    nMonth := nMonth + 1

years  = nMonth / 12.0
cagr   = years > 0 ? math.pow(nav / startCap, 1.0 / years) - 1.0 : float(na)
ddNow  = peak > 0 ? nav / peak - 1.0 : float(na)
totRet = nav / startCap - 1.0
spyTot = spyNav / startCap - 1.0

// only show the curves once compounding has begun (avoid a flat pre-start line)
navPlot = nMonth > 0 ? nav : float(na)
spyPlot = nMonth > 0 ? spyNav : float(na)
plot(navPlot, "Strategy NAV",   color = color.new(#3987e5, 0), linewidth = 2)
plot(spyPlot, "SPY buy & hold", color = color.new(#898781, 0), linewidth = 2)

// risk-off gauge as a faint background tint (>50% cash = defensive), so the
// pane keeps ONE axis (dollars) instead of competing scales
bgcolor(nMonth > 0 and invested < 0.5 ? color.new(#3a1414, 88) : na)

// ---------------------------------------------------------------- dashboard
// dark-panel palette, explicit text color on every cell -- readable in both
// light and dark TradingView themes regardless of chart background
BG_HDR  = color.new(#1a1a1a, 0)
BG_ROW  = color.new(#0d0d0d, 0)
BG_HOLD = color.new(#0e5c38, 0)   // dark green fill
BG_CASH = color.new(#3a1414, 0)   // dark red fill
TXT     = color.new(#ffffff, 0)
TXT_MUT = color.new(#bbbbbb, 0)
POS     = color.new(#0ca30c, 0)
NEG     = color.new(#e66767, 0)

// ---- allocation table (target weights) ----
var table tb = table.new(position.top_right, 5, 10, border_width = 1,
     border_color = color.new(#555555, 0), bgcolor = BG_ROW)
hdr(col, txt) => table.cell(tb, col, 0, txt, text_size = size.small,
     bgcolor = BG_HDR, text_color = TXT)
row(r, name, px, sma, tr, wt) =>
    onCol = tr ? BG_HOLD : BG_CASH
    table.cell(tb, 0, r, name, text_size = size.small, text_halign = text.align_left,
         bgcolor = BG_ROW, text_color = TXT)
    table.cell(tb, 1, r, str.tostring(px,  "#.##"), text_size = size.small,
         bgcolor = BG_ROW, text_color = TXT_MUT)
    table.cell(tb, 2, r, str.tostring(sma, "#.##"), text_size = size.small,
         bgcolor = BG_ROW, text_color = TXT_MUT)
    table.cell(tb, 3, r, tr ? "HOLD" : "CASH", text_size = size.small,
         bgcolor = onCol, text_color = TXT)
    table.cell(tb, 4, r, str.tostring(wt * 100, "#.#") + "%", text_size = size.small,
         bgcolor = BG_ROW, text_color = TXT)

// ---- running-stats table (the "P&L so far" panel) ----
var table st = table.new(position.top_left, 2, 6, border_width = 1,
     border_color = color.new(#555555, 0), bgcolor = BG_ROW)
stat(r, k, v, c) =>
    table.cell(st, 0, r, k, text_size = size.small, text_halign = text.align_left,
         bgcolor = BG_ROW, text_color = TXT_MUT)
    table.cell(st, 1, r, v, text_size = size.small, text_halign = text.align_right,
         bgcolor = BG_ROW, text_color = c)

if barstate.islast
    hdr(0, "Asset")
    hdr(1, "Price")
    hdr(2, str.tostring(smaLen) + "M SMA")
    hdr(3, "Trend")
    hdr(4, "Target wt")
    row(1, "SPY",  c1, m1, t1, w1)
    row(2, "EFA",  c2, m2, t2, w2)
    row(3, "EEM",  c3, m3, t3, w3)
    row(4, "TLT",  c4, m4, t4, w4)
    row(5, "IEF",  c5, m5, t5, w5)
    row(6, "GLD",  c6, m6, t6, w6)
    row(7, "DBC",  c7, m7, t7, w7)
    row(8, "VNQ",  c8, m8, t8, w8)
    table.cell(tb, 0, 9, "CASH (T-bills)", text_size = size.small,
         text_halign = text.align_left, bgcolor = BG_HDR, text_color = TXT)
    table.cell(tb, 3, 9, "", bgcolor = BG_HDR)
    table.cell(tb, 4, 9, str.tostring(cashW * 100, "#.#") + "%",
         text_size = size.small, bgcolor = BG_HDR, text_color = TXT)

    table.cell(st, 0, 0, "SINCE START", text_size = size.small,
         text_halign = text.align_left, bgcolor = BG_HDR, text_color = TXT)
    table.cell(st, 1, 0, str.tostring(nMonth) + " mo", text_size = size.small,
         text_halign = text.align_right, bgcolor = BG_HDR, text_color = TXT)
    stat(1, "Strategy $", str.tostring(math.round(nav)),    TXT)
    stat(2, "SPY $",      str.tostring(math.round(spyNav)), TXT_MUT)
    stat(3, "Total ret",  str.tostring(totRet * 100, "#.#") + "%", totRet >= 0 ? POS : NEG)
    stat(4, "CAGR",       str.tostring(cagr * 100, "#.#") + "%",   cagr   >= 0 ? POS : NEG)
    stat(5, "Max DD",     str.tostring(ddNow * 100, "#.#") + "%",  NEG)

// ------------------------------------------------------------------- alerts
// fires at bar close when any sleeve flips trend state (use a MONTHLY chart
// so "bar close" = month close, matching the backtest's decision point)
flipped = t1 != t1[1] or t2 != t2[1] or t3 != t3[1] or t4 != t4[1] or
     t5 != t5[1] or t6 != t6[1] or t7 != t7[1] or t8 != t8[1]
if flipped and barstate.isconfirmed
    alert("RP+Trend: month-close allocation changed — open the dashboard and rebalance.",
         alert.freq_once_per_bar_close)
